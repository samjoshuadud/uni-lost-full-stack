# ──────────────────────────────────────────────────────────────────────────────
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to source control.
# ──────────────────────────────────────────────────────────────────────────────

# Firebase project configuration (from Firebase Console → Project Settings)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=<your-project-id>.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=<your-project-id>.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Backend API base URL.
# IMPORTANT: Always use HTTPS (https://) in production deployments.
# Using an http:// URL on a host that has HSTS (e.g. *.azurewebsites.net)
# will cause ERR_SSL_PROTOCOL_ERROR in the browser when Google Auth tries to
# call the protected endpoint.
#
# Development:
# NEXT_PUBLIC_API_URL=http://localhost:5067
#
# Azure App Service production example:
# NEXT_PUBLIC_API_URL=https://<your-backend-app>.azurewebsites.net
NEXT_PUBLIC_API_URL=

# Google Gemini API key (optional – used for AI-assisted features)
NEXT_PUBLIC_GEMINI_API_KEY=
